{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run build:auth && wrangler dev --ip 127.0.0.1 --port 3000",
    "build": "vp run build:auth && wrangler deploy --dry-run --outdir dist",
    "build:auth": "vp build --config auth-web/vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply prod-moo --local",
    "db:migrate": "wrangler d1 migrations apply prod-moo --remote",
    "start": "vp run dev",
    "test": "vp run build:auth && vitest run",
    "deploy": "vp run build:auth && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/electron": "catalog:",
    "@mooligan/domain": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
