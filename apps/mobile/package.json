{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "tsc --noEmit && expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "catalog:",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "catalog:",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  }
}
