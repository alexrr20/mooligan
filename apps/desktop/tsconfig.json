{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true
  },
  "include": ["electron", "src", "test", "vite.config.ts"]
}
