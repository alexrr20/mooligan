{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first Magic: The Gathering workspace",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "clean": "node -e \"const { rmSync } = require('node:fs'); for (const output of ['dist', 'dist-electron']) rmSync(output, { force: true, recursive: true })\"",
    "dev": "vp dev",
    "build": "tsc --noEmit && vp run clean && vp build",
    "package": "vp run build && electron-builder --dir",
    "dist": "vp run build && electron-builder",
    "start": "electron .",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@livestore/adapter-web": "catalog:",
    "@livestore/common": "catalog:",
    "@livestore/livestore": "catalog:",
    "@livestore/react": "catalog:",
    "@livestore/sync-cf": "catalog:",
    "@livestore/wa-sqlite": "catalog:",
    "@mooligan/domain": "workspace:*",
    "@mooligan/workspace": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "mana-font": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "unplugin": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  }
}
